POSTGRES_PASSWORD=replace-with-a-long-random-password
SESSION_SECRET=replace-with-a-long-random-secret
INGEST_KEY=replace-with-a-long-random-ingest-key
BOOTSTRAP_TENANT_SLUG=belvanger
BOOTSTRAP_TENANT_NAME=Belvanger
BOOTSTRAP_ADMIN_EMAIL=info@belvanger.nl
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-temporary-password
COOKIE_SECURE=false

# Systeemcheck (optioneel): ontbreken deze, dan geeft de check "unknown" i.p.v. te crashen.
# Eén Twilio-hoofdaccount voor alle klantnummers.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Eén gedeelde n8n-instantie; API-sleutel via n8n instellingen > API.
N8N_API_URL=https://n8n.primecircle.cloud
N8N_API_KEY=

# Hulp (optioneel): ontbreken deze, dan geeft het formulier een nette "nog niet
# geconfigureerd"-melding i.p.v. te crashen. Zelfde Hostinger-mailbox als het
# bestaande leadformulier op belvanger.nl (product/chatbot/.env).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@belvanger.nl
SMTP_PASS=
SMTP_FROM=info@belvanger.nl
SUPPORT_TO=info@belvanger.nl

# --- Meldingen (Web Push) ----------------------------------------------------
# Nodig voor de PWA op het beginscherm EN voor de Android-app (die dezelfde Web
# Push gebruikt via de Trusted Web Activity). Ontbreken deze, dan is push simpelweg
# uit: de meldingenkaart blijft verborgen i.p.v. een dode knop te tonen.
# Genereren: node scripts/generate-vapid-keys.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:info@belvanger.nl

# Telefoonnummer van de beller meesturen in de pushmelding? De payload is
# end-to-end versleuteld (RFC 8291), dus Google ziet alleen ciphertext en het gaat
# om de eigen leaddata van de klant naar zijn eigen toestel. Met "true" krijgt de
# vakman een "Bel terug"-knop die direct de telefoonapp opent; met "false" moet hij
# eerst het dashboard openen. Bewust een expliciete keuze, standaard uit.
PUSH_INCLUDE_CALLER=false

# Publieke URL van het dashboard, gebruikt in de deeplink van meldingen.
PUBLIC_BASE_URL=https://dashboard.belvanger.nl

# --- Android-app (Trusted Web Activity) --------------------------------------
# Vult /.well-known/assetlinks.json. Zonder deze twee krijgt de app een adresbalk
# en ziet Google Play een webview-wrapper (beleid 4.3). Ontbreken ze, dan geeft de
# route 404 in plaats van een half-geldig bestand.
#
# TWA_SHA256_FINGERPRINTS mag meerdere komma-gescheiden fingerprints bevatten, en
# dat is bij Play App Signing ook NODIG: zowel je upload key als de sleutel
# waarmee Google uiteindelijk ondertekent. Zie ANDROID.md stap 6.
TWA_PACKAGE_NAME=nl.belvanger.dashboard
TWA_SHA256_FINGERPRINTS=
