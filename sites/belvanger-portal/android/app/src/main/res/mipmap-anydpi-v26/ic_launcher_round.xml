<?xml version="1.0" encoding="utf-8"?>
<!-- Zelfde adaptive icon: vanaf API 26 maakt de launcher de ronding, dus round en
     gewoon icoon zijn identiek. Het bestand moet er wel zijn omdat het manifest
     android:roundIcon declareert voor de oudere launchers. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
