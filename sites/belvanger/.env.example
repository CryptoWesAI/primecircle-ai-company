# Kopieer naar .env en vul in. Deze .env staat in .gitignore én wordt NIET in de
# Docker-image gebakken (alleen als runtime-env via docker-compose env_file).
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODEL=google/gemini-2.5-flash-lite

# Welke klant-config wordt geladen (map onder product/chatbot/customers, meegebouwd door assemble.mjs).
CUSTOMER=belvanger

# Poort die de container gebruikt (Traefik verwijst naar 8092).
APP_PORT=8092

# Optioneel: max chatverzoeken per IP per minuut (standaard 30).
# RATE_LIMIT_PER_MIN=30

# Analytics-dashboard: leeg = uitgeschakeld. Zet een lange geheime token om het aan te zetten.
DASHBOARD_TOKEN=

# SMTP voor lead-aanvragen (formulier → e-mail naar LEAD_TO). Laat SMTP_PASS leeg
# om /api/lead uit te schakelen (dan valt het formulier terug op mailen/WhatsApp).
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@belvanger.nl
SMTP_PASS=
SMTP_FROM=info@belvanger.nl
LEAD_TO=info@belvanger.nl

# Websiteaanvraag → klantdashboard (tijdlijn + pushmelding op de telefoon).
# Zonder deze twee mailt een aanvraag wel, maar komt hij NIET in het dashboard en
# gaat er geen melding uit. De site en de promotiefilm beloven dat wel, dus dit
# hoort ingevuld te zijn voor elke klant die een dashboard heeft.
# De sleutel is de kanaalsleutel van het kanaal "website" van die klant, aan te maken
# in het dashboard onder Klantinstallaties. Hij wordt maar EEN KEER getoond.
PORTAL_INGEST_URL=https://dashboard.belvanger.nl/api/ingest
PORTAL_INGEST_KEY=
