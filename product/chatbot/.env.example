# Kopieer naar .env (of zet als omgevingsvariabele) en vul je eigen sleutel in.
# OpenRouter-sleutel aanmaken op: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
# Model (instelbaar). Standaard: goedkoop + sterk in Nederlands.
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# Optioneel: andere poort dan 3100
# PORT=3100
# Geheime token voor het analytics-dashboard (leeg = uit).
# Open daarna: http://localhost:3100/dashboard?token=<deze-token>
# DASHBOARD_TOKEN=kies-een-lange-geheime-token
# Optioneel: max chatverzoeken per IP/min (standaard 30); vraagteksten loggen (standaard false)
# RATE_LIMIT_PER_MIN=30
# LOG_QUESTIONS=false
# Productie: beperk welk domein het widget mag aanroepen (standaard * voor lokaal testen)
# ALLOWED_ORIGIN=https://abaandachtenbetrokkenheiduitvaartzorg.nl
